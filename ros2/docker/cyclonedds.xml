<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS config for the CFEAR online node.

  The per-azimuth FFT stream is ~1600 msgs/s; raise the socket receive buffer so
  bursts are not dropped. NOTE: with host networking (docker run with net=host)
  the container uses the HOST kernel, so the host (or Jetson) must allow it:
      sudo sysctl -w net.core.rmem_max=10485760
  Mirror whatever buffer sizes are configured on the robot side.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true"/>
      </Interfaces>
    </General>
    <Internal>
      <!-- min= would be a HARD requirement (node aborts if the kernel refuses);
           request 10MB via max= instead so an unconfigured host still works. -->
      <SocketReceiveBufferSize min="default" max="10MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
